# Przykładowy plik .env - skopiuj jako .env i uzupełnij
PORT=5000
MONGODB_URI=mongodb://localhost:27017/bks_koordynator
NODE_ENV=development

# Wiele adresów oddziel przecinkami (allowlista CORS)
FRONTEND_URL=http://localhost:3000

# Sekret do podpisywania tokenów JWT - ustaw długi, losowy ciąg w produkcji!
JWT_SECRET=zmien-na-dlugi-losowy-sekret
JWT_TTL=8h

# Dane do jednorazowego utworzenia administratora (npm run seed:admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
